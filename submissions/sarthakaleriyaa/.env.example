# Copy to .env and replace every placeholder. Never commit .env.
# cp .env.example .env

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=documind
POSTGRES_USER=documind
# Use letters and digits only: it is embedded in a connection URL.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
# Host port for the database (localhost only).
DB_PORT=5433
API_PORT=8000

# Only needed when running the API or tests outside Docker (see README "Without Docker").
DATABASE_URL=postgresql+psycopg://documind:change-me-to-a-long-random-value@localhost:5433/documind

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- AI provider ---
# gemini: Google Gemini API (sends document text and questions to Google).
# local:  offline lexical embeddings + extractive answers; no network, no cost, for dev/tests.
AI_PROVIDER=local
GEMINI_API_KEY=
# Model IDs (defaults shown). The embedding model must support 768-dimensional output.
# The generation model must accept thinking_level=LOW. gemini-3.8-flash also works but
# its free tier allows only ~20 requests per day per project.
GEMINI_GENERATION_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# MINIMAL, LOW (default), MEDIUM or HIGH. Must be supported by the generation model.
GEMINI_THINKING_LEVEL=LOW
GEMINI_TIMEOUT_MS=15000
GEMINI_RETRY_ATTEMPTS=2
# Optional: prices in USD per million tokens, used for usage.estimated_cost_usd.
# Leave empty to report the cost as null (unknown) rather than guessing.
GEMINI_INPUT_USD_PER_MTOK=
GEMINI_OUTPUT_USD_PER_MTOK=

# --- Limits ---
RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_MB=10
LOG_LEVEL=INFO

# --- Worker ---
WORKER_POLL_SECONDS=2
# Provider-outage retries wait base, 2x base, ... (capped at 300 s); 3 attempts in total.
WORKER_RETRY_BASE_SECONDS=30
# /health reports the worker down after this many seconds without a heartbeat.
WORKER_HEARTBEAT_STALE_SECONDS=60

# --- Single-service hosting (e.g. Render free plan; see render.yaml) ---
# Run the ingestion worker inside the API process instead of a separate service.
RUN_EMBEDDED_WORKER=false
# Run `alembic upgrade head` when the container starts (hosts without a pre-deploy step).
RUN_MIGRATIONS_ON_START=false
